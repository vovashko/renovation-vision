# Same Supabase project as RenoVision.
# Local dev: `supabase start`, then `supabase status -o env` for these two values.
# See README -> Local Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Set to "true" on the hosted demo only: shows the demo manager/client credentials
# under the sign-in form.
VITE_DEMO_HINT=

# Browser Sentry DSN (EU data region: a *.ingest.de.sentry.io project). A DSN is public by design —
# it ships to every browser — so this is a VITE_* build-time value, not a secret (the server's own
# DSN, SENTRY_DSN, is: see .dev.vars.example). Optional: src/lib/sentry-client.ts is a no-op
# without it. See README → Observability.
VITE_SENTRY_DSN=
