# Local Worker secrets and vars for `bun run dev`, `bun run preview` and `wrangler dev`.
# Copy to `.dev.vars` (gitignored) and fill in as needed; the server reads them from
# `import { env } from "cloudflare:workers"` (src/lib/env.ts), validated with clear messages.
# Remote secrets are set per environment with `wrangler secret put <NAME> --env <preview|production>`.
# Keep comments on their own lines: dotenv would read `KEY= # text` as part of the value.

# Server-side Supabase secret key (sb_secret_…). Bypasses RLS; only src/server/** may use it,
# through @/lib/supabase/admin. Never put it in a VITE_* variable.
# Local stack: the SECRET_KEY line of `supabase status -o env`.
# The legacy name SUPABASE_SERVICE_ROLE_KEY (a service_role JWT) is still accepted as a fallback.
SUPABASE_SECRET_KEY=

# Overrides wrangler.jsonc → vars.APP_ENV: development | preview | production | test.
APP_ENV=development

# Transactional email (Brevo) API key for @/server/email (sendEmail). REQUIRED in preview/production
# (sendEmail throws EMAIL_NOT_CONFIGURED without it there); optional in development/test, where
# emails are just logged (not delivered) when unset. A free Brevo account's API key works fine for
# local testing with EMAIL_SANDBOX=true below. See README -> Email.
BREVO_API_KEY=

# The "From" address for app emails. Needs a verified sender in Brevo once BREVO_API_KEY is set.
# Defaults to "RenoVision <no-reply@renovision.app>" when unset.
EMAIL_FROM=

# true: every Brevo send adds the sandbox header (validates the request, delivers nothing — see
# README -> Email). Set this locally whenever BREVO_API_KEY is set, so testing never sends a real
# email. `bun run email:check` always forces sandbox mode regardless of this variable.
EMAIL_SANDBOX=

# Sentry project DSN for server-side (Worker) error reporting: https://<key>@<host>/<project-id>,
# where <host> is a *.ingest.de.sentry.io project (EU data region — pick "EU" when creating the
# Sentry project). Optional: everything in src/lib/sentry-worker.ts is a no-op without it, so local
# dev and CI don't need a Sentry account. See README → Observability.
SENTRY_DSN=
