{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "renovision",
  // Recent date supported by the installed wrangler/workerd (see package.json).
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  // Built by @cloudflare/vite-plugin from the "ssr" Vite environment (vite.config.ts),
  // which TanStack Start points at src/server.ts (our SSR error wrapper).
  "main": "src/server.ts",
  // Cloudflare Workers Logs.
  "observability": {
    "enabled": true,
  },
  // Public, non-secret config available in every environment unless overridden below.
  "vars": {
    "APP_ENV": "development",
  },
  // Workers Rate Limiting bindings, one per policy in src/server/middleware/rate-limit.ts (RATE_LIMITS
  // holds the same numbers; a unit test fails if they drift). `period` is 10 or 60 seconds.
  // `ratelimits` is not inherited, so each env below repeats it with its own namespace_id
  // (a namespace is an account-wide counter: preview and production must not share one).
  "ratelimits": [
    { "name": "RATE_LIMIT_DEFAULT", "namespace_id": "72101", "simple": { "limit": 120, "period": 60 } },
    { "name": "RATE_LIMIT_INVITE", "namespace_id": "72102", "simple": { "limit": 10, "period": 60 } },
    { "name": "RATE_LIMIT_EMAIL", "namespace_id": "72103", "simple": { "limit": 5, "period": 60 } },
  ],
  "env": {
    // `bun run deploy:preview` — a scratch Worker for reviewing branches before they merge.
    "preview": {
      "name": "renovision-preview",
      "vars": {
        "APP_ENV": "preview",
      },
      "ratelimits": [
        { "name": "RATE_LIMIT_DEFAULT", "namespace_id": "72201", "simple": { "limit": 120, "period": 60 } },
        { "name": "RATE_LIMIT_INVITE", "namespace_id": "72202", "simple": { "limit": 10, "period": 60 } },
        { "name": "RATE_LIMIT_EMAIL", "namespace_id": "72203", "simple": { "limit": 5, "period": 60 } },
      ],
    },
    // `bun run deploy` — the live Worker.
    "production": {
      "name": "renovision",
      "vars": {
        "APP_ENV": "production",
      },
      "ratelimits": [
        { "name": "RATE_LIMIT_DEFAULT", "namespace_id": "72301", "simple": { "limit": 120, "period": 60 } },
        { "name": "RATE_LIMIT_INVITE", "namespace_id": "72302", "simple": { "limit": 10, "period": 60 } },
        { "name": "RATE_LIMIT_EMAIL", "namespace_id": "72303", "simple": { "limit": 5, "period": 60 } },
      ],
    },
  },
}
